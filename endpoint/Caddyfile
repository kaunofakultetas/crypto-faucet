:80 {
    route {

        # ------------------------------------------------------------
        #                         Security headers
        # ------------------------------------------------------------
        # SECURITY: Block other applications from accessing the application at the Caddy level
        @foreign expression `{http.request.header.Origin} != "" && !{http.request.header.Origin}.endsWith("://" + {http.request.host})`
        respond @foreign 403

        #################################################
        #### CSP Disabled, required for DAPPS server ####
        #################################################
        # # SECURITY: Restricts the scripts in the browser from communicating with external sources
        # header Content-Security-Policy "
        #     default-src         'self';
        #     script-src          'self' 'unsafe-inline' 'unsafe-eval';
        #     style-src           'self' 'unsafe-inline';
        #     img-src             'self' data:;
        #     font-src            'self' data:;
        #     connect-src         'self';
        #     frame-ancestors     'self';
        #     frame-src           'self';
        #     child-src           'self';
        #     form-action         'self';
        #     base-uri            'self';
        #     worker-src          'self';
        #     upgrade-insecure-requests;
        # "

        # SECURITY: Force HTTPS for this domain
        header Strict-Transport-Security "max-age=31536000"

        # ------------------------------------------------------------
        # ------------------------------------------------------------
        # ------------------------------------------------------------




        header {
            Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
            Pragma "no-cache"
        }





        ##### UNAUTHENTICATED: Etherpad Notes
        redir /etherpad /etherpad/
        handle /etherpad/* {
            # Strip the prefix '/etherpad' before proxying
            uri strip_prefix /etherpad
            reverse_proxy faucet-etherpad:9001 {
                header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
            }
        }






        # ------------------------------------------------------------
        #              Protected behind: APP_PASSWORD_1
        # ------------------------------------------------------------
        @hasCookie1 header_regexp cookieCheck Cookie "(;|^|\ )app-password={$APP_PASSWORD_1}(;|$|\ )"
        handle @hasCookie1 {

            # DAPPS HOSTING
            redir /dapps/hosting /dapps/hosting/
            handle /dapps/hosting/* {
                reverse_proxy faucet-dapps-caddy:80 {
                    header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
                }
            }

            # DAPPS FILEBROWSER
            handle /dapps/* {
                reverse_proxy faucet-dapps-filebrowser:80 {
                    header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
                }
            }

            # DBGATE
            redir /dbgate /dbgate/
            handle /dbgate/* {
                reverse_proxy faucet-dbgate:3000 {
                    header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
                }
            }

            # BACKEND API
            handle /api/* {
                reverse_proxy faucet-backend:8000 {
                    header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
                }
            }

            # PRESENTATIONS
            redir /served/presentations /served/presentations/
            handle /served/presentations/* {
                root * /var/www/presentations
                uri strip_prefix /served/presentations
                file_server browse
                header {
                    Cache-Control "public, max-age=86400"
                    -Pragma
                }
            }

            # VITE
            handle /* {
                reverse_proxy faucet-vite:80 {
                    header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
                }
            }
        }

        # ------------------------------------------------------------
        # ------------------------------------------------------------
        # ------------------------------------------------------------










        # ------------------------------------------------------------
        #                   UNAUTHENTICATED ROUTES
        # ------------------------------------------------------------
        #
        # The login SPA and the files it needs to render — the only
        # paths served without the cookie: the page itself, its
        # js/css bundles, the VU logo, the system-name endpoint and
        # the favicon (no-store caching comes from the global
        # header block above)
        # ------------------------------------------------------------

        @loginApp path /login /assets/* /img/* /app/title /favicon.ico
        handle @loginApp {
            reverse_proxy faucet-login:80 {
                header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
            }
        }



        # Everything else bounces to the login page carrying the
        # wanted URL ({uri} = path+query); after a successful login
        # the login app sends the user back there. Caddy cannot
        # url-encode, so a wanted URL holding '&' keeps only its
        # first query parameter through the bounce — fine for the
        # faucet's URLs.
        # =========================================================
        handle /* {

            # the '*' matcher is required: a target starting with
            # '/' would otherwise parse as a path matcher
            # ===================================================
            redir * /login?redirect={uri}

        }

        # ------------------------------------------------------------
        # ------------------------------------------------------------
        # ------------------------------------------------------------





    }
}
