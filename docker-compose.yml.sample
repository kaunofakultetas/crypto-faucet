services:

  # ------------------------------------------------------------
  #              Incoming/outgoing traffic endpoints
  # ------------------------------------------------------------
  faucet-endpoint:
    container_name: faucet-endpoint
    image: caddy:2.11-alpine
    user: 1000:1000
    read_only: true
    environment:
      ############################ SISTEMOS PASSWORD #######################
      APP_PASSWORD_1: FAUCET_GUI_PASSWORD
      ######################################################################
    volumes:
      - ./endpoint/Caddyfile:/etc/caddy/Caddyfile:ro
      - ./_VIDEOS:/var/www/videos:ro
    ports:
      - 80:80
    networks:
      - external
    restart: unless-stopped
  

  faucet-exit:
    container_name: faucet-exit
    image: vuknf/caddy-l4:2.11
    user: 1000:1000
    read_only: true
    volumes:
      - ./exit/Caddyfile:/etc/caddy/Caddyfile:ro
    networks:
      external: {}
      isolated:
        ipv4_address: 172.18.102.30
    restart: unless-stopped
  # ------------------------------------------------------------
  # ------------------------------------------------------------
  # ------------------------------------------------------------







  # ------------------------------------------------------------
  #                        Students gate
  # ------------------------------------------------------------
  faucet-login:
    container_name: faucet-login
    image: vuknf/simple-login-page:20260401
    user: 1000:1000
    read_only: true
    environment:
      VITE_SYSTEM_NAME: "KNF Testnet<br/>Kriptovaliutų Faucet'as"
    networks:
      - isolated
    restart: unless-stopped
  # ------------------------------------------------------------
  # ------------------------------------------------------------
  # ------------------------------------------------------------











  # ------------------------------------------------------------
  #                    Crypto Faucet Services
  # ------------------------------------------------------------
  faucet-vite:
    container_name: faucet-vite

    # Docker hub
    image: vuknf/faucet-vite:latest

    # # Self-built
    # image: faucet-vite
    # build:
    #   context: ./vite
    #   # dockerfile: Dockerfile                                                         # Prod
    #   dockerfile: Dockerfile.dev                                                     # Dev

    user: 1000:1000
    read_only: true
    # tmpfs:                                                                           # Dev
    #   - /home/node/.npm:uid=1000,gid=1000                                            # Dev
    # volumes:                                                                         # Dev
    #   - ./vite/app:/app                                                              # Dev
    networks:
      - isolated
      # - external                                                                     # Dev
    restart: unless-stopped


  faucet-backend:
    container_name: faucet-backend
    
    # Docker hub
    image: vuknf/faucet-backend:latest
    
    # # Self-built
    # image: faucet-backend
    # build: ./backend
    
    user: 1000:1000
    read_only: true
    environment:
      # App Configuration
      # - APP_DEBUG=True                                                               # Dev

      # Faucet Configs:
      - INFURA_PROJECT_ID=${INFURA_PROJECT_ID}
      - ETHERSCAN_API_KEY=${ETHERSCAN_API_KEY}
      - FAUCET_PRIVATE_KEY=${FAUCET_PRIVATE_KEY}
    tmpfs:
      - /.bitcoinlib:uid=1000,gid=1000
      - /tmp:uid=1000,gid=1000
    volumes:
      # Configuration
      - /etc/localtime:/etc/localtime:ro
      - ./_CONFIG:/config:ro

      # Backend Database
      - ./_DATA/backend:/data

      # Backend Source Code
      # - ./backend:/app                                                               # Dev
    dns:
      - 172.18.102.31
    networks:
      - isolated
      # - external                                                                     # Dev
    restart: unless-stopped


  faucet-dns:
    container_name: faucet-dns
    image: dockurr/dnsmasq:2.92
    user: 1000:1000
    read_only: true
    entrypoint: ["dnsmasq", "--no-daemon"]
    command:
      - --no-resolv
      - --no-hosts
      - --address=/#/172.18.102.30
    networks:
      isolated:
        ipv4_address: 172.18.102.31
    restart: unless-stopped
  # ------------------------------------------------------------
  # ------------------------------------------------------------
  # ------------------------------------------------------------








  
  # ------------------------------------------------------------
  #                   Crypto Faucet Notes
  # ------------------------------------------------------------
  faucet-etherpad:
    container_name: faucet-etherpad
    image: etherpad/etherpad:2.2.7
    user: 1000:1000
    read_only: true
    environment:
      - TITLE=Etherpad
      - DEFAULT_PAD_TEXT=KNF Faucet Notes
    tmpfs:
      - /tmp:uid=1000,gid=1000
    volumes:
      - ./_DATA/etherpad:/opt/etherpad-lite/var
    networks:
      - isolated
    restart: unless-stopped
  # ------------------------------------------------------------
  # ------------------------------------------------------------
  # ------------------------------------------------------------












  # ------------------------------------------------------------
  #                           Dapps services
  # ------------------------------------------------------------
  faucet-dapps-filebrowser:
    container_name: faucet-dapps-filebrowser
    image: vuknf/filebrowser-noauth:latest
    user: 1000:1000
    read_only: false
    volumes:
      # Filebrowser Configuration
      - ./dapps/settings.json:/config/settings.json

      # Dapps Root Directory
      - ./_DATA/dapps:/data
    networks:
      - isolated
    restart: unless-stopped


  faucet-dapps-caddy:
    container_name: faucet-dapps-caddy
    image: caddy:2.11-alpine
    user: 1000:1000
    read_only: true
    volumes:
      # Caddy Configuration
      - ./dapps/Caddyfile:/etc/caddy/Caddyfile:ro

      # Dapps Root Directory
      - ./_DATA/dapps:/srv:ro
    networks:
      - isolated
    restart: unless-stopped
  # ------------------------------------------------------------
  # ------------------------------------------------------------
  # ------------------------------------------------------------












  # ------------------------------------------------------------
  #              Additional administration services 
  # ------------------------------------------------------------
  faucet-dbgate:
    container_name: faucet-dbgate
    image: dbgate/dbgate:7.2.0
    user: root
    read_only: true
    environment:
      WEB_ROOT: /dbgate

      LOGINS: admin
      LOGIN_PASSWORD_admin: ${DBGATE_PASSWORD}

      CONNECTIONS: con1
      LABEL_con1: KNF Faucet DB
      FILE_con1: /data/database.db
      ENGINE_con1: sqlite@dbgate-plugin-sqlite

    volumes:
      - ./_DATA/backend:/data
    networks:
      - isolated
    restart: unless-stopped
  # ------------------------------------------------------------
  # ------------------------------------------------------------
  # ------------------------------------------------------------







networks:
  external:
    external: true
  isolated:
    name: faucet-isolated
    driver: bridge
    internal: true
    ipam:
      config:
        - subnet: 172.18.102.0/24
          gateway: 172.18.102.1
